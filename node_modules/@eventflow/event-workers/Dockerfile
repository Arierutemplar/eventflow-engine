FROM node:20-alpine AS builder

WORKDIR /app
COPY package*.json ./
COPY apps/api-gateway/package.json apps/api-gateway/package.json
COPY apps/event-workers/package.json apps/event-workers/package.json
COPY apps/notification-service/package.json apps/notification-service/package.json
COPY packages/common/package.json packages/common/package.json
COPY packages/database/package.json packages/database/package.json
COPY packages/event-bus/package.json packages/event-bus/package.json
RUN npm ci
COPY tsconfig.json ./
COPY apps apps
COPY packages packages
RUN npx prisma generate --schema=packages/database/prisma/schema.prisma \
    && npm run build --workspace=@eventflow/event-workers \
    && npm prune --omit=dev \
    && npm cache clean --force

FROM node:20-alpine AS runner

ENV NODE_ENV=production
WORKDIR /app
RUN addgroup -S eventflow && adduser -S eventflow -G eventflow
COPY --from=builder /app/package.json /app/package-lock.json ./
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/dist ./dist
COPY --from=builder /app/packages/common/package.json ./packages/common/package.json
COPY --from=builder /app/packages/database/package.json ./packages/database/package.json
COPY --from=builder /app/packages/event-bus/package.json ./packages/event-bus/package.json
COPY --from=builder /app/dist/packages/common/src ./packages/common/dist
COPY --from=builder /app/dist/packages/database/src ./packages/database/dist
COPY --from=builder /app/dist/packages/event-bus/src ./packages/event-bus/dist
RUN node -e "const fs=require('fs'); for (const p of ['common','database','event-bus']) { const f='packages/'+p+'/package.json'; const j=JSON.parse(fs.readFileSync(f)); j.main='./dist/index.js'; j.types='./dist/index.d.ts'; j.exports={'.':{types:'./dist/index.d.ts',import:'./dist/index.js',default:'./dist/index.js'}}; fs.writeFileSync(f, JSON.stringify(j)); }" \
    && chown -R eventflow:eventflow /app

USER eventflow
EXPOSE 4001
CMD ["node", "dist/apps/event-workers/src/index.js"]