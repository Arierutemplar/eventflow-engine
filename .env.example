NODE_ENV=development

# --- Desarrollo local (docker-compose.yml) ---
DATABASE_URL=postgresql://eventuser:eventpassword@localhost:5432/eventflow_db?schema=public
RABBITMQ_URL=amqp://guest:guest@localhost:5672
REDIS_URL=redis://localhost:6379
API_PORT=3002

# --- Producción (docker-compose.prod.yml) ---
POSTGRES_USER=eventflow
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_DB=eventflow_db

RABBITMQ_USER=eventflow
RABBITMQ_PASS=change-me-rabbitmq

GRAFANA_USER=admin
GRAFANA_PASSWORD=change-me-grafana

SERVICE_NAME=eventflow-service
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces
RATE_LIMIT_POINTS=100
RATE_LIMIT_DURATION_SECONDS=60
